{
  "name": "synapsis",
  "version": "0.7.0",
  "description": "Synapsis 析域 —— 概念图面板",
  "type": "module",
  "main": "index.js",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/en.json",
    "locale/zh.json",
    "package.json",
    "assets/katex/katex.min.js",
    "assets/katex/katex.min.css",
    "assets/katex/fonts"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "slots"
      ]
    }
  }
}
