{
  "name": "dsh-synapsis",
  "version": "0.11.0",
  "description": "Synapsis 析域 —— 把讲义铺成一张能走进去的概念图（DSH Web UI 面板插件）",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mindmap",
    "concept-map",
    "knowledge-graph",
    "study"
  ],
  "type": "module",
  "main": "index.js",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE",
    "locale/en.json",
    "locale/zh.json",
    "package.json",
    "assets/katex/katex.min.js",
    "assets/katex/katex.min.css",
    "assets/katex/fonts"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "scripts": {
    "build": "node tools/build-plugin.mjs",
    "dev": "node tools/dev-server.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "license": "MIT",
  "author": {
    "name": "Mathilde1214",
    "email": "CharlesR1214@outlook.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mathilde1214/dsh-synapsis.git"
  },
  "bugs": {
    "url": "https://github.com/Mathilde1214/dsh-synapsis/issues"
  },
  "homepage": "https://github.com/Mathilde1214/dsh-synapsis#readme"
}
